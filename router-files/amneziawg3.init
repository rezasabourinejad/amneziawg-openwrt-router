#!/bin/sh /etc/rc.common
# AmneziaWG 3.1 client — kernel-mode (kmod-amneziawg 3.1)
START=94
STOP=15

start() {
    /usr/sbin/awg3-up
}

stop() {
    ip link del awg1 2>/dev/null
    while ip rule del prio 15110 2>/dev/null; do :; done
    ip route flush table 110 2>/dev/null
    return 0
}

restart() {
    stop
    start
}
