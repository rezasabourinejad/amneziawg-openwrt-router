#!/bin/sh
# JSON status for the LuCI "AmneziaWG VPN" page (read-only, runs only while the page is open).
IF=awg1
TUNNEL_NET=10.8.1.0/24
PING_TARGET=""                         # default: first address of TUNNEL_NET (Amnezia server = 10.8.1.0)
[ -f /etc/amneziawg/awg3.env ] && . /etc/amneziawg/awg3.env
[ -n "$PING_TARGET" ] || PING_TARGET=${TUNNEL_NET%/*}

up=0; age=-1; rx=0; tx=0; port=0; endpoint=""; rtt=""
if ip link show "$IF" >/dev/null 2>&1; then
	up=1
	hs=$(awg show "$IF" latest-handshakes 2>/dev/null | awk '{print $2; exit}')
	[ -n "$hs" ] && [ "$hs" != 0 ] && age=$(( $(date +%s) - hs ))
	set -- $(awg show "$IF" transfer 2>/dev/null | awk '{print $2, $3; exit}')
	rx=${1:-0}; tx=${2:-0}
	port=$(awg show "$IF" listen-port 2>/dev/null)
	endpoint=$(awg show "$IF" endpoints 2>/dev/null | awk '{print $2; exit}')
	rtt=$(ping -c 2 -W 1 -q "$PING_TARGET" 2>/dev/null | awk -F/ '/round-trip/{print $4}')
fi
rule=$(ip rule 2>/dev/null | grep -c "lookup 110")
bypass=$(ip route show table 110 2>/dev/null | grep -c throw)
boot=0; ls /etc/rc.d/S*amneziawg3 >/dev/null 2>&1 && boot=1
wan=$(cat /sys/class/net/wan/carrier 2>/dev/null || echo 0)
printf '{"up":%d,"handshake_age":%d,"rx":%s,"tx":%s,"listen_port":"%s","endpoint":"%s","rtt":"%s","rule":%d,"bypass":%d,"boot":%d,"wan_link":%d}\n' \
	"$up" "$age" "$rx" "$tx" "$port" "$endpoint" "$rtt" "$rule" "$bypass" "$boot" "$wan"
